#include<bits/stdc++.h>
using namespace std;
#define ll long long
const int N=5e5+10;

void go(){
    int n,k;
    cin>>n>>k;
    vector<int >a(n+1);
    vector<int >s(n+1);
    s[0]=0;
    for(int i=1;i<=n;i++){
    	cin>>a[i];
    	s[i] = s[i-1]+a[i];
	}
	int ans=s[k];
	//cout<<ans<<endl; 
	int pos=1;
	for(int i=2;i<=n-k+1;i++){
		int tmp = s[i+k-1]-s[i-1]; 
		if(tmp<ans){
			ans = tmp;
			pos =i;
		}
	}
	
	cout<<pos<<endl;
 }

signed main(){
    ios::sync_with_stdio(false),cin.tie(0);  	
        go();
    return 0;
}


